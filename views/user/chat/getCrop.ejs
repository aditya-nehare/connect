<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Crop Recommendation System</title>
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      }
      .card {
        border: none;
        border-radius: 15px;
        backdrop-filter: blur(10px);
        background: rgba(255, 255, 255, 0.95);
      }
      .form-control {
        border-radius: 8px;
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
      }
      .form-control:focus {
        border-color: #28a745;
        box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.25);
      }
      .btn-primary {
        background: linear-gradient(45deg, #28a745, #20c997);
        border: none;
        border-radius: 8px;
        font-weight: 600;
        padding: 12px;
        transition: transform 0.2s ease;
      }
      .btn-primary:hover {
        transform: translateY(-2px);
        background: linear-gradient(45deg, #218838, #1da589);
      }
      .alert {
        border-radius: 8px;
        border: none;
      }
      .crop-icon {
        animation: bounce 2s infinite;
      }
      @keyframes bounce {
        0%,
        20%,
        50%,
        80%,
        100% {
          transform: translateY(0);
        }
        40% {
          transform: translateY(-10px);
        }
        60% {
          transform: translateY(-5px);
        }
      }
      .form-label {
        font-weight: 600;
        color: #495057;
        margin-bottom: 8px;
      }
      .loading {
        display: none;
      }
      .loading.show {
        display: inline-block;
      }
    </style>
  </head>
  <body>
    <div class="container py-5">
      <div class="row justify-content-center">
        <div class="col-md-8">
          <div class="card shadow-lg">
            <div class="card-body p-5">
              <h2 class="text-center text-success mb-4">
                🌱 Crop Recommendation System
                <img
                  src="https://cdn-icons-png.flaticon.com/512/765/765514.png"
                  width="35"
                  alt="plant icon"
                  class="crop-icon ms-2"
                />
              </h2>
              <p class="text-center text-muted mb-4">
                Enter your soil and environmental conditions to get personalized
                crop recommendations
              </p>

              <!-- Form -->
              <form id="cropForm">
                <div class="row mb-3">
                  <div class="col-md-4">
                    <label class="form-label">Nitrogen (N)</label>
                    <input
                      type="number"
                      class="form-control"
                      name="nitrogen"
                      min="0"
                      max="300"
                      placeholder="0-300"
                      required
                    />
                    <small class="text-muted">mg/kg</small>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Phosphorus (P)</label>
                    <input
                      type="number"
                      class="form-control"
                      name="phosphorus"
                      min="0"
                      max="150"
                      placeholder="0-150"
                      required
                    />
                    <small class="text-muted">mg/kg</small>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Potassium (K)</label>
                    <input
                      type="number"
                      class="form-control"
                      name="potassium"
                      min="0"
                      max="300"
                      placeholder="0-300"
                      required
                    />
                    <small class="text-muted">mg/kg</small>
                  </div>
                </div>

                <div class="row mb-3">
                  <div class="col-md-4">
                    <label class="form-label">Temperature</label>
                    <input
                      type="number"
                      step="0.1"
                      class="form-control"
                      name="temperature"
                      min="0"
                      max="50"
                      placeholder="0-50"
                      required
                    />
                    <small class="text-muted">°C</small>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Humidity</label>
                    <input
                      type="number"
                      class="form-control"
                      name="humidity"
                      min="0"
                      max="100"
                      placeholder="0-100"
                      required
                    />
                    <small class="text-muted">%</small>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">pH Level</label>
                    <input
                      type="number"
                      step="0.1"
                      class="form-control"
                      name="ph"
                      min="3"
                      max="10"
                      placeholder="3.0-10.0"
                      required
                    />
                    <small class="text-muted">pH scale</small>
                  </div>
                </div>

                <div class="row mb-4">
                  <div class="col-md-6">
                    <label class="form-label">Rainfall</label>
                    <input
                      type="number"
                      class="form-control"
                      name="rainfall"
                      min="0"
                      max="3000"
                      placeholder="0-3000"
                      required
                    />
                    <small class="text-muted">mm/year</small>
                  </div>
                </div>

                <!-- Button -->
                <div class="d-grid">
                  <button type="submit" class="btn btn-primary btn-lg">
                    <span
                      class="loading spinner-border spinner-border-sm me-2"
                      role="status"
                    ></span>
                    <span class="btn-text">🔍 Get Crop Recommendation</span>
                  </button>
                </div>
              </form>

              <!-- Recommendation Result -->
              <div id="result" class="mt-4 d-none"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Crop recommendation data based on typical growing conditions
      const cropDatabase = {
        rice: {
          nitrogen: [80, 120],
          phosphorus: [40, 60],
          potassium: [40, 60],
          temperature: [20, 27],
          humidity: [80, 100],
          ph: [5.5, 7.0],
          rainfall: [1000, 2000],
        },
        wheat: {
          nitrogen: [50, 80],
          phosphorus: [30, 50],
          potassium: [30, 50],
          temperature: [12, 25],
          humidity: [50, 70],
          ph: [6.0, 7.5],
          rainfall: [350, 700],
        },
        corn: {
          nitrogen: [100, 150],
          phosphorus: [40, 80],
          potassium: [60, 100],
          temperature: [18, 27],
          humidity: [60, 80],
          ph: [6.0, 7.0],
          rainfall: [500, 800],
        },
        cotton: {
          nitrogen: [80, 120],
          phosphorus: [40, 60],
          potassium: [40, 60],
          temperature: [21, 30],
          humidity: [50, 80],
          ph: [5.8, 8.0],
          rainfall: [500, 1000],
        },
        sugarcane: {
          nitrogen: [150, 200],
          phosphorus: [60, 100],
          potassium: [100, 150],
          temperature: [20, 30],
          humidity: [70, 90],
          ph: [6.0, 8.0],
          rainfall: [1000, 1500],
        },
        potato: {
          nitrogen: [60, 100],
          phosphorus: [40, 70],
          potassium: [80, 120],
          temperature: [15, 22],
          humidity: [70, 85],
          ph: [5.0, 6.5],
          rainfall: [400, 600],
        },
        tomato: {
          nitrogen: [80, 120],
          phosphorus: [50, 80],
          potassium: [60, 100],
          temperature: [18, 27],
          humidity: [60, 80],
          ph: [6.0, 7.0],
          rainfall: [400, 800],
        },
        soybean: {
          nitrogen: [40, 60],
          phosphorus: [40, 60],
          potassium: [60, 80],
          temperature: [20, 30],
          humidity: [60, 80],
          ph: [6.0, 7.0],
          rainfall: [450, 700],
        },
        barley: {
          nitrogen: [40, 70],
          phosphorus: [30, 50],
          potassium: [30, 50],
          temperature: [12, 22],
          humidity: [50, 70],
          ph: [6.0, 7.5],
          rainfall: [300, 600],
        },
        groundnut: {
          nitrogen: [20, 40],
          phosphorus: [40, 80],
          potassium: [60, 100],
          temperature: [20, 30],
          humidity: [50, 70],
          ph: [6.0, 7.0],
          rainfall: [500, 750],
        },
      };

      function calculateSuitabilityScore(inputValues, cropRequirements) {
        let totalScore = 0;
        const factors = [
          "nitrogen",
          "phosphorus",
          "potassium",
          "temperature",
          "humidity",
          "ph",
          "rainfall",
        ];

        factors.forEach((factor) => {
          const value = parseFloat(inputValues[factor]);
          const [min, max] = cropRequirements[factor];

          if (value >= min && value <= max) {
            totalScore += 100; // Perfect match
          } else if (value < min) {
            const deficit = min - value;
            const range = max - min;
            totalScore += Math.max(0, 100 - (deficit / range) * 50);
          } else {
            const excess = value - max;
            const range = max - min;
            totalScore += Math.max(0, 100 - (excess / range) * 50);
          }
        });

        return totalScore / factors.length;
      }

      function getCropRecommendation(inputValues) {
        const scores = {};

        Object.keys(cropDatabase).forEach((crop) => {
          scores[crop] = calculateSuitabilityScore(
            inputValues,
            cropDatabase[crop]
          );
        });

        // Sort by score
        const sortedCrops = Object.entries(scores)
          .sort(([, a], [, b]) => b - a)
          .slice(0, 3);

        return sortedCrops;
      }

      function getCropEmoji(cropName) {
        const emojis = {
          rice: "🌾",
          wheat: "🌾",
          corn: "🌽",
          cotton: "🌿",
          sugarcane: "🎋",
          potato: "🥔",
          tomato: "🍅",
          soybean: "🫘",
          barley: "🌾",
          groundnut: "🥜",
        };
        return emojis[cropName] || "🌱";
      }

      function getScoreColor(score) {
        if (score >= 80) return "text-success";
        if (score >= 60) return "text-warning";
        return "text-danger";
      }

      function getScoreBadge(score) {
        if (score >= 80) return "badge bg-success";
        if (score >= 60) return "badge bg-warning";
        return "badge bg-danger";
      }

      document.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById("cropForm");
        const resultDiv = document.getElementById("result");
        const loadingSpinner = document.querySelector(".loading");
        const btnText = document.querySelector(".btn-text");

        form.addEventListener("submit", async (e) => {
          e.preventDefault();

          // Show loading state
          loadingSpinner.classList.add("show");
          btnText.textContent = "Analyzing conditions...";

          // Hide previous results
          resultDiv.classList.add("d-none");

          // Simulate processing delay
          setTimeout(() => {
            try {
              // Collect form data
              const formData = new FormData(form);
              const inputValues = Object.fromEntries(formData.entries());

              // Get recommendations
              const recommendations = getCropRecommendation(inputValues);

              // Create result HTML
              let resultHTML = `
              <div class="alert alert-success">
                <h5 class="alert-heading mb-3">🎯 Crop Recommendations Based on Your Conditions</h5>
                <div class="row">
            `;

              recommendations.forEach(([crop, score], index) => {
                const emoji = getCropEmoji(crop);
                const badgeClass = getScoreBadge(score);
                const rank = index === 0 ? "🥇" : index === 1 ? "🥈" : "🥉";

                resultHTML += `
                <div class="col-md-4 mb-3">
                  <div class="card h-100 ${
                    index === 0 ? "border-success" : ""
                  }">
                    <div class="card-body text-center">
                      <div class="fs-1 mb-2">${emoji}</div>
                      <h6 class="card-title text-capitalize">${rank} ${crop}</h6>
                      <span class="${badgeClass}">${score.toFixed(
                  0
                )}% Match</span>
                      ${
                        index === 0
                          ? '<div class="mt-2"><small class="text-success fw-bold">Best Match!</small></div>'
                          : ""
                      }
                    </div>
                  </div>
                </div>
              `;
              });

              resultHTML += `
                </div>
                <hr>
                <div class="mt-3">
                  <h6>💡 Tips for optimal growth:</h6>
                  <ul class="mb-0">
                    <li>Monitor soil nutrient levels regularly</li>
                    <li>Ensure proper irrigation based on rainfall patterns</li>
                    <li>Consider crop rotation to maintain soil health</li>
                    <li>Adjust fertilizer application based on soil test results</li>
                  </ul>
                </div>
              </div>
            `;

              resultDiv.innerHTML = resultHTML;
              resultDiv.classList.remove("d-none");

              // Scroll to results
              resultDiv.scrollIntoView({
                behavior: "smooth",
                block: "nearest",
              });
            } catch (err) {
              resultDiv.innerHTML = `
              <div class="alert alert-danger">
                <h5 class="alert-heading">❌ Error</h5>
                <p class="mb-0">Unable to process your request: ${err.message}</p>
              </div>
            `;
              resultDiv.classList.remove("d-none");
            } finally {
              // Hide loading state
              loadingSpinner.classList.remove("show");
              btnText.textContent = "🔍 Get Crop Recommendation";
            }
          }, 1500); // 1.5 second delay for realistic feel
        });
      });
    </script>
  </body>
</html>
