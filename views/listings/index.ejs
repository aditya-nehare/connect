<% layout('layouts/boilerplate') -%>

<body class="bg-transparent">
  <%- include("../includes/carousel") %>
  <div class="container py-4">
    <div class="row g-4">
      <% for (let listing of allListings) { %>
      <div class="col-sm-12 col-md-6 col-lg-4">
        <div class="card h-100 border-0 overflow-hidden">
          <img
            src="<%= listing.image %>"
            alt="Listing image"
            class="img-fluid rounded fixed-image"
            style="width: 100%; height: 400px; object-fit: cover"
          />
          <div
            class="card-body d-flex flex-column px-1 overflow-hidden pt-3 pb-5"
          >
            <h5 class="fw-semibold text-dark mb-2" style="font-size: 1.1rem">
              <%= listing.title %>
            </h5>
          </div>
          <a href="/listings/<%= listing._id %>" class="stretched-link"></a>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</body>
